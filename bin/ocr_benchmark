#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "ruby_llm"
require "json"
require "optparse"
require "digest"
require "fileutils"
require_relative "../lib/server/ocr/source_workflow"
require_relative "../lib/server/ocr/benchmark_scorer"

def run_benchmark(targets:, options:)
  options[:repeat].times.flat_map do |run_idx|
    run_num = run_idx + 1
    targets.each_with_index.map do |target, target_idx|
      case_id = target[:case_id]
      path = target[:image]
      artifact_name = case_id || "#{target_idx + 1}-#{File.basename(path, ".*")}"
      artifact_dir = options[:artifacts_dir] ? File.join(options[:artifacts_dir], "run-#{run_num}", artifact_name) : nil

      workflow = Ocr::SourceWorkflow.new(model: options[:model], reasoning_effort: options[:effort])

      row = {
        case_id: case_id,
        image: path,
        run: run_num,
        fallback_year: options[:fallback_year],
        ruby_llm_version: Gem.loaded_specs.fetch("ruby_llm").version.to_s
      }.compact

      begin
        analysis = workflow.analyze(
          path,
          additional_text: options[:text],
          fallback_year: options[:fallback_year],
          artifact_dir: artifact_dir
        )
        row.merge!(analysis)
      rescue => e
        evidence = workflow.run_evidence
        row.merge!(evidence)
        row[:error] = {
          stage: (e.respond_to?(:stage) && e.stage) ? e.stage.to_s : evidence[:stage],
          type: e.class.name,
          message: e.message
        }
      end

      puts JSON.generate(row)
      $stdout.flush
      row
    end
  end
end

def write_json_output(path, payload)
  return unless path

  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, JSON.pretty_generate(payload) + "\n")
end

def resolve_targets(options, argv_paths)
  if options[:cases]
    cases = Ocr::BenchmarkScorer.load_cases(options[:cases], verify_sha256: true)
    unless options[:case_ids].empty?
      cases = cases.select { |c| options[:case_ids].include?(c.fetch("id")) }
      abort "No matching cases for --case #{options[:case_ids].join(",")}" if cases.empty?
    end
    cases.map { |c| {case_id: c.fetch("id"), image: c.fetch("resolved_image_path"), expected_route: c["expected_route"]} }
  else
    argv_paths.each { |path| abort "Input does not exist: #{path}" unless File.file?(path) }
    argv_paths.map { |path| {case_id: nil, image: path} }
  end
end

options = {
  model: Ocr::SourceWorkflow::DEFAULT_MODEL,
  effort: Ocr::SourceWorkflow::DEFAULT_REASONING_EFFORT,
  output: nil,
  repeat: 1,
  cases: nil,
  case_ids: [],
  score_only: nil,
  artifacts_dir: nil,
  fallback_year: Time.now.year,
  text: nil,
  dry_run: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: ./dockerized.sh ruby bin/ocr_benchmark [options] [IMAGE_OR_PDF ...]"
  opts.on("--model MODEL", "Reader OpenAI or Gemini model ID (default: #{options[:model]})") { |value| options[:model] = value }
  opts.on("--effort EFFORT", "Reader reasoning effort (default: #{options[:effort]})") { |value| options[:effort] = value }
  opts.on("--cases PATH", "Score/run against cases.json fixture manifest") { |value| options[:cases] = value }
  opts.on("--case IDS", "Filter case IDs from --cases (comma-separated or repeatable)") { |value| options[:case_ids].concat(value.split(",").map(&:strip)) }
  opts.on("--repeat COUNT", Integer, "Repeat every input with fresh reader calls (default: 1)") { |value| options[:repeat] = value }
  opts.on("--fallback-year YEAR", Integer, "Fallback year when source omits year (default: current year)") { |value| options[:fallback_year] = value }
  opts.on("--text TEXT", "Optional additional_text passed to OCR") { |value| options[:text] = value }
  opts.on("--artifacts-dir DIR", "Persist source inputs, requests and responses per run") { |value| options[:artifacts_dir] = value }
  opts.on("--output PATH", "Write full JSON results (and score report when --cases is set) to this file") { |value| options[:output] = value }
  opts.on("--score-only PATH", "Offline score an existing benchmark JSON output against --cases without API calls") { |value| options[:score_only] = value }
  opts.on("--dry-run", "Offline check inputs/hashes and print execution plan without making paid API calls") { options[:dry_run] = true }
end

parser.parse!

if options[:score_only]
  abort "Must provide --cases PATH with --score-only" unless options[:cases]
  abort "Saved results file does not exist: #{options[:score_only]}" unless File.file?(options[:score_only])

  loaded = JSON.parse(File.read(options[:score_only]))
  runs = (loaded.is_a?(Hash) && loaded.key?("runs")) ? loaded.fetch("runs") : loaded
  report = Ocr::BenchmarkScorer.score_runs(runs, cases_path: options[:cases])
  write_json_output(options[:output], report)
  puts JSON.pretty_generate(report[:aggregates])
  exit 0
end

abort parser.to_s if options[:cases].nil? && ARGV.empty?
abort "Repeat count must be positive" unless options[:repeat].positive?

targets = resolve_targets(options, ARGV)
reader = {reader: options[:model], reader_effort: options[:effort]}

if options[:dry_run]
  plan = {
    dry_run: true,
    paid_api_calls: false,
    repeat: options[:repeat],
    fallback_year: options[:fallback_year],
    planned_runs: targets.length * options[:repeat],
    models: reader,
    cases: targets.map do |target|
      {
        case_id: target[:case_id],
        image: target[:image],
        sha256: Digest::SHA256.file(target[:image]).hexdigest,
        expected_route: target[:expected_route]
      }.compact
    end
  }.compact
  write_json_output(options[:output], plan)
  puts JSON.pretty_generate(plan)
  exit 0
end

runs = run_benchmark(targets: targets, options: options)
payload = {
  cases_path: options[:cases],
  repeat: options[:repeat],
  fallback_year: options[:fallback_year],
  models: reader,
  runs: runs
}.compact
if options[:cases]
  payload[:score] = Ocr::BenchmarkScorer.score_runs(runs, cases_path: options[:cases])
end
write_json_output(options[:output], payload)
puts JSON.pretty_generate(payload.dig(:score, :aggregates)) if payload[:score]
exit 1 if runs.any? { |run| run.key?(:error) }
