#!dockerized.sh ruby
# frozen_string_literal: true

require "bundler/setup"

Bundler.require(:development)

require "json"
require "optparse"
require "pp"
require "ruby_llm"
require_relative "../lib/server/event_ocr_service"
require_relative "../lib/server/ocr/source_workflow"

options = {
  workflow: "legacy",
  text: nil,
  fallback_year: Time.now.year,
  model: nil,
  effort: nil,
  artifacts_dir: nil,
  json: false
}

parser = OptionParser.new do |opts|
  opts.banner = "Usage: #{$0} [options] <file_path>"
  opts.on("--workflow MODE", %w[legacy source], "OCR workflow: legacy (default, supports PDF) or source (whole image)") { |value| options[:workflow] = value }
  opts.on("--text TEXT", "--additional-text TEXT", "Additional event context supplied by the operator") { |value| options[:text] = value }
  opts.on("--fallback-year YEAR", Integer, "Fallback year when source omits year (default: current year)") { |value| options[:fallback_year] = value }
  opts.on("--model MODEL", "Reader model ID override") { |value| options[:model] = value }
  opts.on("--effort EFFORT", "Reader reasoning effort override") { |value| options[:effort] = value }
  opts.on("--artifacts-dir DIR", "New or empty artifact directory for the source workflow") { |value| options[:artifacts_dir] = value }
  opts.on("--json", "Print machine-readable JSON output") { options[:json] = true }
end

begin
  parser.parse!
rescue OptionParser::ParseError => e
  warn e.message
  warn parser
  exit 1
end

if ARGV.length != 1
  puts "Usage: #{$0} [options] <file_path>"
  puts "Example image: #{$0} ./my_image.jpg"
  puts "Example PDF: #{$0} /tmp/my_events.pdf"
  puts "Example source workflow: #{$0} --workflow source --json ./my_image.jpg"
  exit 1
end

input_path = ARGV[0]

unless File.exist?(input_path)
  puts "Error: File '#{input_path}' does not exist."
  exit 1
end

begin
  if options[:workflow] == "source"
    workflow_options = {}
    workflow_options[:model] = options[:model] if options[:model]
    workflow_options[:reasoning_effort] = options[:effort] if options[:effort]
    result = Ocr::SourceWorkflow.call(input_path, additional_text: options[:text], fallback_year: options[:fallback_year], artifact_dir: options[:artifacts_dir], **workflow_options)
    puts(options[:json] ? JSON.pretty_generate(result) : result.pretty_inspect)
  else
    service_options = {}
    service_options[:model] = options[:model] if options[:model]
    service_options[:reasoning_effort] = options[:effort] if options[:effort]
    service = EventOcrService.new(**service_options)

    unless options[:json]
      puts "Analyzing file: #{input_path}"
      puts "Detected PDF input; processing all pages." if File.extname(input_path).casecmp(".pdf").zero?
      puts
    end

    result = service.analyze(input_path, additional_text: options[:text], fallback_year: options[:fallback_year])
    if options[:json]
      puts JSON.pretty_generate(result)
    else
      puts "Analysis result:"
      puts "=" * 50
      pp result
      puts "=" * 50
    end
  end
rescue => e
  warn "Error processing file: #{e.message}"
  warn "Error details: #{e.class}"
  warn e.backtrace.join("\n")

  if e.message.match?(/api_key/i)
    warn ""
    warn "Set OPENAI_API_KEY for OpenAI, or GEMINI_API_KEY when OCR_MODEL=gemini-flash-latest."
  end

  exit 1
end
